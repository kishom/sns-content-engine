# 生成される配信キュー（export.mjs の出力・再生成可能）
content/**/queue.json
content/*.queue.json

# 生成される動画・画像（render.mjs の出力・再生成可能）
*.mp4
*.png
.render/

# ビルドマニフェスト（build.mjs の出力・再生成可能）
content/build-manifest.json

# 認証情報・環境変数（絶対にコミットしない）
.env
.env.*
*.local

# OS / エディタ
.DS_Store
node_modules/

# プロフィールアイコンは成果物としてコミットする
!assets/icon.png

# キャラ基準画像は「確定デザインの正本」＝全生成の参照元なのでコミットする
!assets/char-ref/*.png
!assets/char-ref/expressions/*.png

# char3d でレンダリングしたカット構図（I2V生成の入力画像）はコミットする
# ※ render.mjs が出力する動画用の中間PNGとは別物（あちらは .render/ 配下）
!content/**/cut-*.png

# char3d のデバッグ出力（柄の左右検証用・再生成可能）
scripts/char3d/debug/

# compose.mjs の中間ファイル（KEEP_WORK=1 のとき残る・再生成可能）
scripts/compose/.compose/

# tts.mjs の中間ファイル（KEEP_WORK=1 のとき残る・再生成可能）
scripts/compose/.voice/

# 合成音声の書き出し（tts.mjs の出力・11MB・完全に再生成可能＝*.mp4 と同じ扱い）
# ※ voice.timing.json と voice.readings.txt は小さく、レビュー資料になるのでコミットする
content/**/voice.wav

# VOICEVOX CORE のランタイム（1.2GB・再取得可能。取得手順は scripts/compose/README.md）
.venv-voicevox/
.voicevox/

# 旧版の退避（比較用・ローカルのみ）
*.bak

# Python のキャッシュ
__pycache__/
