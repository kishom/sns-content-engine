# 生成される配信キュー（export.mjs の出力・再生成可能）
content/**/queue.json
content/*.queue.json

# 生成される動画・画像（render.mjs の出力・再生成可能）
*.mp4
*.png
.render/

# ビルドマニフェスト（build.mjs の出力・再生成可能）
content/build-manifest.json

# 認証情報・環境変数（絶対にコミットしない）
.env
.env.*
*.local

# OS / エディタ
.DS_Store
node_modules/

# プロフィールアイコンは成果物としてコミットする
!assets/icon.png

# キャラ基準画像は「確定デザインの正本」＝全生成の参照元なのでコミットする
!assets/char-ref/*.png

# char3d のデバッグ出力（柄の左右検証用・再生成可能）
scripts/char3d/debug/
